# Internal-testing VPS stack (docker-compose.internal.yml). Copy to deploy/.env.internal (gitignored), replace every CHANGE_ME, `chmod 600` it.
# Used twice: compose variable substitution (--env-file) and the backend env_file.
# Full variable reference: apps/backend/.env.example.
# Generate secrets with: openssl rand -base64 48

# --- Domains (A records -> VPS IP) ---
APP_DOMAIN=app.rescom.com.vn
S3_DOMAIN=s3.rescom.com.vn

# --- Postgres (compose) + backend connection; keep the three values in sync ---
POSTGRES_USER=rescom
POSTGRES_PASSWORD=CHANGE_ME_db_password_hex_only
POSTGRES_DB=rescom_db
DATABASE_URL=postgresql://rescom:CHANGE_ME_db_password_hex_only@postgres:5432/rescom_db?schema=public&options=-c%20timezone%3DUTC

# --- Backend ---
# Pilot: docker-compose.internal.yml builds the frontend with NEXT_PUBLIC_API_MOCKING=disabled and
# NEXT_PUBLIC_PILOT_BUILD=true (export is client-side, so the flag hides it); nothing to set here.
NODE_ENV=production
PORT=4000
SCHEDULER_ENABLED=true
# AD-23: Cloudflare -> Caddy -> NestJS. The API trusts exactly one hop (Caddy) and keys rate limits on
# the client address in X-Forwarded-For. With Cloudflare on DNS-only (current configuration, see
# deploy/README.md), Caddy sets X-Forwarded-For directly to the connecting client peer.
# (If Cloudflare proxying is ever enabled, Caddy would need trusted_proxies + client_ip_headers
# to restore CF-Connecting-IP into X-Forwarded-For so users do not share Cloudflare's egress IPs).
# Never raise this: extra hops let a caller spoof X-Forwarded-For.
TRUST_PROXY_HOPS=1
# Per client IP and window: the strict bucket for login / register / password reset (IR.5, Q5).
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=60
FRONTEND_ORIGINS=https://app.rescom.com.vn

JWT_SECRET=CHANGE_ME
AUTH_SECRET_PROTECTION_KEY=CHANGE_ME
AUTH_SECRET_KEY_VERSION=1
COMPLETION_CODE_HMAC_SECRET=CHANGE_ME
STORAGE_CAPABILITY_SECRET=CHANGE_ME

# Google Console: authorised redirect URI = GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://app.rescom.com.vn/api/auth/google/callback
AUTH_FRONTEND_SUCCESS_URL=https://app.rescom.com.vn/auth/callback
AUTH_FRONTEND_ERROR_URL=https://app.rescom.com.vn/auth/error

# External SMTP provider (Brevo/Resend/SES...), port 587 STARTTLS.
EMAIL_DELIVERY_MODE=smtp
EMAIL_FROM=Rescom <no-reply@rescom.com.vn>
EMAIL_APP_BASE_URL=https://app.rescom.com.vn
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# MinIO root credentials == backend storage keys. Presigned URLs use the public HTTPS host.
STORAGE_ENDPOINT=https://s3.rescom.com.vn
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rescom-private-storage
STORAGE_ACCESS_KEY_ID=CHANGE_ME_min_3_chars
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_min_8_chars
STORAGE_FORCE_PATH_STYLE=true

MALWARE_SCANNER_HOST=clamav
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=30000

TOPUP_BANK_NAME=Vietcombank
TOPUP_BANK_BIN=970436
TOPUP_BANK_ACCOUNT_NUMBER=CHANGE_ME
TOPUP_BANK_ACCOUNT_NAME=CHANGE_ME

ABUSE_CONTROL_PROFILE=REDIS_DISABLED_SINGLE_REPLICA
PARTICIPATION_RATE_LIMIT_POLICY_VERSION=participation-rate-limit-v1

# Off-site backup target for deploy/backup.sh (an rclone remote:path)
RCLONE_REMOTE=b2:rescom-backup
