# AD-23 pilot VM (docker-compose.prod.yml, Story 11.1). Copy to deploy/.env.prod on the VM,
# `chmod 600`, replace every CHANGE_ME. Never commit it: secrets live only in this file and in
# GitHub Actions secrets (NFR-ADD-3). Staging gets its own copy with its own values (AD-17).
# Used twice: compose variable substitution (--env-file) and the api env_file.
# Full variable reference: apps/backend/.env.example. Secrets: openssl rand -base64 48

# --- Edge (Caddyfile) ---
# Public API edge hostname behind Cloudflare; Vercel's RESCOM_API_URL points here.
API_DOMAIN=api.rescom.com.vn
# Shared with Vercel's server-only RESCOM_EDGE_KEY (openssl rand -hex 32); rotate both together.
# Caddy rejects every non-/health call without it, so the client IP header below cannot be forged.
EDGE_KEY=CHANGE_ME
# Caddy trusts X-Rescom-Client-Ip only from these peers: Cloudflare's ranges, as published at
# https://www.cloudflare.com/ips/ (checked 2026-10-03). Refresh when Cloudflare changes them.
TRUSTED_PROXY_RANGES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

# --- Image (Story 11.3 sets API_TAG to the commit SHA) ---
API_IMAGE=ghcr.io/qxh1145/rescom-api
API_TAG=CHANGE_ME

# --- Backend ---
NODE_ENV=production
PORT=4000
# AD-5 amendment: the one api replica owns the scheduler; claims stay in PostgreSQL.
SCHEDULER_ENABLED=true
# Caddy hands NestJS exactly one X-Forwarded-For entry (the client, see deploy/Caddyfile).
# Never raise this: extra hops let a caller spoof X-Forwarded-For.
TRUST_PROXY_HOPS=1
# Per client IP and window: the strict bucket for login / register / password reset (IR.5, Q5).
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=60
FRONTEND_ORIGINS=https://app.rescom.com.vn

# Cloud SQL private IP (Story 11.2). TLS to Cloud SQL: keep sslmode=require.
DATABASE_URL=postgresql://rescom:CHANGE_ME@10.0.0.3:5432/rescom_db?schema=public&sslmode=require&options=-c%20timezone%3DUTC

JWT_SECRET=CHANGE_ME
AUTH_SECRET_PROTECTION_KEY=CHANGE_ME
AUTH_SECRET_KEY_VERSION=1
COMPLETION_CODE_HMAC_SECRET=CHANGE_ME
STORAGE_CAPABILITY_SECRET=CHANGE_ME

# Google Console: authorised redirect URI = GOOGLE_REDIRECT_URI below (same host as the app).
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://app.rescom.com.vn/api/auth/google/callback
AUTH_FRONTEND_SUCCESS_URL=https://app.rescom.com.vn/auth/callback
AUTH_FRONTEND_ERROR_URL=https://app.rescom.com.vn/auth/error

# External SMTP provider (Brevo/Resend/SES...), port 587 STARTTLS.
EMAIL_DELIVERY_MODE=smtp
EMAIL_FROM=Rescom <no-reply@rescom.com.vn>
EMAIL_APP_BASE_URL=https://app.rescom.com.vn
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# Cloud Storage through its S3 interoperability API with an HMAC key scoped to this bucket.
# StoredObject.bucket is persisted: a later host must reuse this name or migrate it (AD-23).
STORAGE_ENDPOINT=https://storage.googleapis.com
# STORAGE_REGION=auto is provisional pending AC 7 verification against GCS in Story 11.2 (or asia-southeast1).
STORAGE_REGION=auto
STORAGE_BUCKET=CHANGE_ME
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_FORCE_PATH_STYLE=true

MALWARE_SCANNER_HOST=clamav
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=30000

TOPUP_BANK_NAME=Vietcombank
TOPUP_BANK_BIN=970436
TOPUP_BANK_ACCOUNT_NUMBER=CHANGE_ME
TOPUP_BANK_ACCOUNT_NAME=CHANGE_ME

ABUSE_CONTROL_PROFILE=REDIS_DISABLED_SINGLE_REPLICA
PARTICIPATION_RATE_LIMIT_POLICY_VERSION=participation-rate-limit-v1
