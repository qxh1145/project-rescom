# Application Environment Configuration Example
NODE_ENV=development
PORT=4000

# System Monitoring & Metrics Logging (interval in seconds; 0 to disable periodic log)
SYSTEM_METRICS_LOG_INTERVAL_SECONDS=30

# Story IR.2b: in-process scheduler + Outbox dispatcher (pending-release, starter-expiry,
# reservation-expiry, deadline-close, storage-cleanup, outbox-dispatch). Off by default:
# enable it on exactly ONE API replica. Never starts under NODE_ENV=test. With it off,
# nothing time-based runs (no 48h release, no deadline close, no upload cleanup).
# SCHEDULER_ENABLED=false
# Tick period in seconds (1-300); every job keeps its own cadence on top of it.
# SCHEDULER_TICK_SECONDS=15
# Outbox deliveries before an event is dead-lettered (1-50; ~2h of backoff at 8).
# OUTBOX_MAX_ATTEMPTS=8

# Database (the `postgres` service of the root docker-compose.yml)
# The scheduler's lease / deadline SQL expects a UTC session; if `SHOW TimeZone` is not UTC
# the API logs DB_SESSION_TIMEZONE_NOT_UTC. Fix it by appending `&options=-c%20timezone%3DUTC`.
DATABASE_URL=postgresql://rescom_admin:rescom_password@localhost:5433/rescom_db?schema=public

# Authentication & Security
JWT_SECRET=replace_with_at_least_32_characters_secret_for_local_dev_only
JWT_ACCESS_TTL_SECONDS=900
BCRYPT_ROUNDS=12
SESSION_ABSOLUTE_TTL_SECONDS=2592000
OAUTH_INTENT_TTL_SECONDS=600
AUTH_SECRET_PROTECTION_KEY=replace_with_at_least_32_characters_key_for_protection_only
AUTH_SECRET_KEY_VERSION=1
# Story 4.5: HMAC key for External-survey completion-code verifiers (min 32 chars).
# Optional (falls back to JWT_SECRET); set it so rotating JWT_SECRET does not
# invalidate live completion codes. Changing it invalidates existing codes.
COMPLETION_CODE_HMAC_SECRET=replace_with_at_least_32_characters_completion_code_key
# Epic 5 review: HMAC key of the guest upload capability bound to a survey attempt
# (min 32 chars). Optional (falls back to JWT_SECRET).
STORAGE_CAPABILITY_SECRET=replace_with_at_least_32_characters_storage_capability_key

# CORS (Comma-separated list of allowed frontend origins)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Number of explicitly trusted reverse-proxy hops (set to 1 for the direct Nginx hop)
TRUST_PROXY_HOPS=0

# API rate limiting (Story 1.6): at most *_MAX_REQUESTS requests per *_TTL_SECONDS,
# counted per route; past the limit the API answers 429 RATE_LIMIT_EXCEEDED with
# Retry-After. `default` covers every route. A request whose access-token cookie verifies (signature
# and expiry) is counted per user, anything else per client IP (req.ip, see
# TRUST_PROXY_HOPS). Behind the Next.js /api proxy every browser shares the proxy's IP.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
# `auth` is the stricter bucket for credential endpoints only: register, login, forgot and
# reset password, Google OAuth start/callback and Google link/unlink. It always counts per
# client IP, even for a signed-in caller, so behind the Next.js /api proxy (without
# TRUST_PROXY_HOPS) every browser shares one auth bucket. Session upkeep (GET /auth/me, GET /auth/csrf, POST /auth/refresh,
# POST /auth/logout) stays on `default`. Testers sharing one IP share these 10 logins
# per minute; raise the value in a local .env if that is too tight.
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
# With NODE_ENV=test, limits left at these defaults (100 and 10) are raised to 10000 so
# e2e suites do not trip them; any other value applies as set.

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
AUTH_FRONTEND_SUCCESS_URL=http://localhost:3000/auth/callback
AUTH_FRONTEND_ERROR_URL=http://localhost:3000/auth/error

# Mail (Story IR.4b part B + plan 5.4): critical notification emails (top-up approved or
# rejected, account locked or unlocked) and password-reset links.
#   smtp     portable SMTP (nodemailer). The default below points at the local Mailpit:
#            `docker compose up -d mailpit`, then read every mail at http://localhost:8025
#            (SMTP on 127.0.0.1:1025, no auth, no TLS). Without Mailpit running, sends fail
#            and are retried, then dead-lettered.
#   capture  (the default when unset, outside production) keep sent mail in process memory only
#   disabled send nothing (no email Outbox rows are queued)
# Notification emails go out through the Outbox dispatcher: they need SCHEDULER_ENABLED=true.
# Production refuses capture/disabled, requires SMTP credentials and an HTTPS EMAIL_APP_BASE_URL.
# Secrets only through the environment (AD-23); never commit real credentials.
EMAIL_DELIVERY_MODE=smtp
EMAIL_FROM=Rescom <no-reply@rescom.local>
# Optional support address shown in emails and used as Reply-To.
# EMAIL_REPLY_TO=hotro@rescom.local
# Base of links in emails (reset link, wallet); defaults to the first FRONTEND_ORIGINS entry.
# EMAIL_APP_BASE_URL=http://localhost:3000
# Message-ID domain; defaults to the domain of EMAIL_FROM.
# EMAIL_MESSAGE_ID_DOMAIN=rescom.local
EMAIL_SEND_TIMEOUT_MS=10000
# Mailpit (local only). For a provider use port 587 (STARTTLS) or 465 with SMTP_SECURE=true.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# false only for local Mailpit (no STARTTLS); production requires TLS.
SMTP_REQUIRE_TLS=false
# Set both or neither (Mailpit needs none).
# SMTP_USERNAME=replace_with_smtp_username
# SMTP_PASSWORD=replace_with_smtp_password

# Private S3-compatible object storage (local Docker defaults shown): the `minio` service
# of the root docker-compose.yml (S3 API :9000, console http://localhost:9001). Its root
# credentials equal the key pair below; `minio-init` creates the private bucket, and the
# browser upload CORS allow-list is MINIO_API_CORS_ALLOW_ORIGIN in the compose file.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rescom-private-storage
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# ClamAV daemon used for fail-closed malware scanning
MALWARE_SCANNER_HOST=127.0.0.1
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=30000

# Manual Point top-up (Story 6.6): platform bank account shown with the transfer syntax.
# TOPUP_BANK_BIN is the 6-digit NAPAS/VietQR bank BIN (970436 = Vietcombank).
# Production refuses the placeholder account number/name below.
TOPUP_BANK_NAME=Vietcombank
TOPUP_BANK_BIN=970436
TOPUP_BANK_ACCOUNT_NUMBER=0000000000
TOPUP_BANK_ACCOUNT_NAME=RESCOM DEMO

# Bot protection (Story 8.2, FR-46, NFR-4, AD-6). Centrally versioned policy; the defaults
# below are the provisional launch values named participation-rate-limit-v1 (they still
# await PRD Open Question 16 approval). REDIS_DISABLED_SINGLE_REPLICA counts
# completions in PostgreSQL and request bursts in-process (run ONE API replica). REDIS_SHARED
# is refused at startup until the Redis counter store adapter is installed.
ABUSE_CONTROL_PROFILE=REDIS_DISABLED_SINGLE_REPLICA
# Decision E8-D4: the policy version stamped on every participation 429 and RATE_LIMIT
# FraudLog entry. REQUIRED in production (startup fails without it); optional elsewhere
# (defaults to participation-rate-limit-v1). participation-rate-limit-v1 may only name the
# default values: when any PARTICIPATION_* value below differs, use a new version name
# (e.g. participation-rate-limit-2026-10-pilot). 1-64 chars: letters/digits, then . _ : -
PARTICIPATION_RATE_LIMIT_POLICY_VERSION=participation-rate-limit-v1
# Max completed surveys per user per rolling window
PARTICIPATION_COMPLETION_LIMIT=20
PARTICIPATION_COMPLETION_WINDOW_SECONDS=3600
# Max attempt-start / submission / completion-code requests per user per action per window
PARTICIPATION_BURST_LIMIT=10
PARTICIPATION_BURST_WINDOW_SECONDS=60

# Ops requirement (decision E8-D3): an Admin can never moderate (approve/reject) their own
# survey (403 MODERATION_SELF_REVIEW_FORBIDDEN) nor approve their own top-up (Story 6.6).
# Provision AT LEAST TWO active ADMIN accounts before the pilot, otherwise an Admin's own
# surveys can never go live. Admin accounts are not configured here: promote the users
# (role ADMIN, status ACTIVE) in the database.

# Go-live demo seed (`npm run seed`, src/scripts/seed.ts). All optional.
# Admin account created by the seed (demo accounts use the @rescom.test domain).
SEED_ADMIN_EMAIL=admin@rescom.test
# Second Admin, so each Admin's own surveys and top-ups have another Admin to review them.
# A database seeded before it existed gets only this account on the next `npm run seed`.
SEED_ADMIN2_EMAIL=admin2@rescom.test
# Leave the passwords empty to generate strong random ones; every seeded email
# and generated password is then written to .seed-credentials.local.md (gitignored).
# SEED_ADMIN_PASSWORD is shared by both Admins.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
# The seed refuses NODE_ENV=production unless this is true.
SEED_ALLOW_PRODUCTION=false
