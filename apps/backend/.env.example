# Application Environment Configuration Example
NODE_ENV=development
PORT=4000

# System Monitoring & Metrics Logging (interval in seconds; 0 to disable periodic log)
SYSTEM_METRICS_LOG_INTERVAL_SECONDS=30

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rescom?schema=public

# Authentication & Security
JWT_SECRET=replace_with_at_least_32_characters_secret_for_local_dev_only
JWT_ACCESS_TTL_SECONDS=900
BCRYPT_ROUNDS=12
SESSION_ABSOLUTE_TTL_SECONDS=2592000
OAUTH_INTENT_TTL_SECONDS=600
AUTH_SECRET_PROTECTION_KEY=replace_with_at_least_32_characters_key_for_protection_only
AUTH_SECRET_KEY_VERSION=1
# Story 4.5: HMAC key for External-survey completion-code verifiers (min 32 chars).
# Optional (falls back to JWT_SECRET); set it so rotating JWT_SECRET does not
# invalidate live completion codes. Changing it invalidates existing codes.
COMPLETION_CODE_HMAC_SECRET=replace_with_at_least_32_characters_completion_code_key
# Epic 5 review: HMAC key of the guest upload capability bound to a survey attempt
# (min 32 chars). Optional (falls back to JWT_SECRET).
STORAGE_CAPABILITY_SECRET=replace_with_at_least_32_characters_storage_capability_key

# CORS (Comma-separated list of allowed frontend origins)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Number of explicitly trusted reverse-proxy hops (set to 1 for the direct Nginx hop)
TRUST_PROXY_HOPS=0

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
AUTH_FRONTEND_SUCCESS_URL=http://localhost:3000/auth/callback
AUTH_FRONTEND_ERROR_URL=http://localhost:3000/auth/error

# Private S3-compatible object storage (local Docker defaults shown)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rescom-private-storage
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# ClamAV daemon used for fail-closed malware scanning
MALWARE_SCANNER_HOST=127.0.0.1
MALWARE_SCANNER_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=30000

# Manual Point top-up (Story 6.6): platform bank account shown with the transfer syntax.
# TOPUP_BANK_BIN is the 6-digit NAPAS/VietQR bank BIN (970436 = Vietcombank).
# Production refuses the placeholder account number/name below.
TOPUP_BANK_NAME=Vietcombank
TOPUP_BANK_BIN=970436
TOPUP_BANK_ACCOUNT_NUMBER=0000000000
TOPUP_BANK_ACCOUNT_NAME=RESCOM DEMO

# Bot protection (Story 8.2, FR-46, NFR-4, AD-6). Centrally versioned policy; the defaults
# below are the provisional launch values named participation-rate-limit-v1 (they still
# await PRD Open Question 16 approval). REDIS_DISABLED_SINGLE_REPLICA counts
# completions in PostgreSQL and request bursts in-process (run ONE API replica). REDIS_SHARED
# is refused at startup until the Redis counter store adapter is installed.
ABUSE_CONTROL_PROFILE=REDIS_DISABLED_SINGLE_REPLICA
# Decision E8-D4: the policy version stamped on every participation 429 and RATE_LIMIT
# FraudLog entry. REQUIRED in production (startup fails without it); optional elsewhere
# (defaults to participation-rate-limit-v1). participation-rate-limit-v1 may only name the
# default values: when any PARTICIPATION_* value below differs, use a new version name
# (e.g. participation-rate-limit-2026-10-pilot). 1-64 chars: letters/digits, then . _ : -
PARTICIPATION_RATE_LIMIT_POLICY_VERSION=participation-rate-limit-v1
# Max completed surveys per user per rolling window
PARTICIPATION_COMPLETION_LIMIT=20
PARTICIPATION_COMPLETION_WINDOW_SECONDS=3600
# Max attempt-start / submission / completion-code requests per user per action per window
PARTICIPATION_BURST_LIMIT=10
PARTICIPATION_BURST_WINDOW_SECONDS=60

# Ops requirement (decision E8-D3): an Admin can never moderate (approve/reject) their own
# survey (403 MODERATION_SELF_REVIEW_FORBIDDEN) nor approve their own top-up (Story 6.6).
# Provision AT LEAST TWO active ADMIN accounts before the pilot, otherwise an Admin's own
# surveys can never go live. Admin accounts are not configured here: promote the users
# (role ADMIN, status ACTIVE) in the database.
