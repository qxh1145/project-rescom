generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------
// ENUMS
// ----------------------------------------
enum Role {
  ADMIN
  PUBLISHER
  RESPONDENT
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum FormType {
  INTERNAL
  EXTERNAL
}

enum FormStatus {
  DRAFT
  ESCROW_LOCKED
  MODERATION_QUEUE
  PUBLISHED
  CLOSED
}

/// Who closed a survey (code-review decision E8-D1). Only an OWNER close can
/// be reopened; an Admin takedown (ADMIN) or a moderation rejection
/// (MODERATION) is final. The system closes a survey when its `deadlineAt`
/// passes (DEADLINE, Story IR.2b) or when it reaches its sample target in the
/// same transaction as the last accepted submission (QUOTA, plan 2.3 option A).
/// Mirrors `formCloseKindEnum` in @rescom/schemas (order included).
enum FormCloseKind {
  OWNER
  ADMIN
  MODERATION
  DEADLINE
  QUOTA
}

enum ResponseStatus {
  IN_PROGRESS
  SUBMITTED
  VALIDATED
  DISPUTED
  REJECTED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  LOCKED
}

/// Story IR.2a: why an ABANDONED attempt closed — its reservation ran out
/// (EXPIRED) or the Respondent cancelled it (CANCELLED). Mirrors
/// `attemptCloseReasonSchema` in @rescom/schemas.
enum AttemptCloseReason {
  EXPIRED
  CANCELLED
}

enum IntegrityEventType {
  SURVEY_ATTEMPT_STARTED
  SURVEY_ATTEMPT_RESUMED
  SURVEY_ATTEMPT_ABANDONED
  SURVEY_SUBMITTED
  QUESTION_SHOWN
  QUESTION_FOCUSED
  QUESTION_BLURRED
  ANSWER_SELECTED
  ANSWER_ENTERED
  ANSWER_CHANGED
  ANSWER_CLEARED
  QUESTION_SKIPPED
  QUESTION_RETURNED
  PAGE_HIDDEN
  PAGE_VISIBLE
  ATTENTION_CHECK_PASSED
  ATTENTION_CHECK_FAILED
  TIME_BARRIER_TRIGGERED
  RATE_LIMIT_TRIGGERED
  DEMOGRAPHIC_CONFLICT_DETECTED
  DUPLICATE_PATTERN_DETECTED
  SEMANTIC_QUALITY_EVALUATED
  INTEGRITY_ASSESSMENT_CREATED
  INTEGRITY_POLICY_DECIDED
  INTEGRITY_REVIEW_COMPLETED
  REWARD_PENDING
  REWARD_RELEASED
  REWARD_HELD
  REWARD_REJECTED
  ESCROW_RELEASED
  ESCROW_REFUNDED
}

enum IntegrityRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum FraudLogType {
  TIME_BARRIER
  RATE_LIMIT
  DEMO_MISMATCH
  RECAPTCHA_FAIL
  SECURITY_VIOLATION
}

enum IntegrityIncidentType {
  SPEED_ANOMALY
  ATTENTION_FAILURE
  DEMOGRAPHIC_CONFLICT
  ANSWER_INCONSISTENCY
  DUPLICATE_PATTERN
  ACCOUNT_BEHAVIOR_ANOMALY
  AUTOMATION_SUSPECTED
  NETWORK_ANOMALY
}

enum IntegrityIncidentStatus {
  OPEN
  REVIEWED
}

enum IntegritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IntegrityResolution {
  DISMISSED
  CONFIRMED_LOW_QUALITY
  CONFIRMED_FRAUD
}

enum PolicyStatus {
  DRAFT
  SHADOW
  ADVISORY
  ENFORCED
  RETIRED
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum NotificationType {
  SURVEY_APPROVED
  SURVEY_REJECTED
  ESCROW_RELEASED
  TOPUP_SUCCESS
  REWARD_EARNED
  REWARD_PENDING
  REWARD_RELEASED
  ACCOUNT_ACTIVATED
  WARNING
  /// Story IR.4b B3: appended (keep at the end, same order as NOTIFICATION_TYPES).
  TOPUP_REJECTED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
}

/// Story IR.4b B5: one email delivery attempt per notification. Mirrors
/// `EMAIL_DELIVERY_STATUSES` in @rescom/schemas.
enum EmailDeliveryStatus {
  SENDING
  SENT
  FAILED
  UNCONFIRMED
  SKIPPED
}

/// Plan 5.6: why a session was revoked, so the API can tell "replaced by a
/// newer login" (AUTH_SESSION_REPLACED) apart from other revocations. NULL on
/// rows that are not revoked or were revoked before the column existed.
///   LOGOUT         the user logged out (`POST /auth/logout`);
///   REPLACED       a newer login of the same account (single active session);
///   REFRESH_REUSE  a used refresh credential was replayed (theft defence);
///   ADMIN_LOCK     an Admin locked the account;
///   ROLE_CHANGED   an Admin changed the account role;
///   PASSWORD_RESET the password was reset through a reset token (plan 5.4).
enum SessionRevokeReason {
  LOGOUT
  REPLACED
  REFRESH_REUSE
  ADMIN_LOCK
  ROLE_CHANGED
  PASSWORD_RESET
}

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Story 8.1: outcome of an Admin survey moderation decision.
enum SurveyModerationOutcome {
  APPROVED
  REJECTED
}

/// Story 9.2 (FR-43): optional issue tags covering the FR-43 dimensions
/// besides the overall rating. Must equal `SURVEY_FEEDBACK_ISSUE_TAGS`.
enum SurveyFeedbackIssueTag {
  UNCLEAR_QUESTIONS
  LONGER_THAN_ESTIMATED
  MISLEADING_DESCRIPTION
  TECHNICAL_ISSUE
}

/// Story 9.2: feedback enters Survey Quality aggregation only when ACCEPTED.
enum SurveyFeedbackValidationStatus {
  PENDING
  ACCEPTED
  EXCLUDED
}

enum LedgerAccountClass {
  USER_AVAILABLE
  PENDING
  FROZEN
  ESCROW
  INTEGRITY_HOLD
  SYSTEM_ISSUANCE
  SYSTEM_SINK
  SYSTEM_CLEARING
}

enum AssessmentApplicability {
  APPLICABLE
  NOT_ASSESSED
  INSUFFICIENT_EVIDENCE
}

enum StoredObjectStatus {
  INITIATED
  UPLOADED
  QUARANTINED
  CLEAN
  ATTACHED
  REJECTED
  EXPIRED
  DELETED
}

enum StoredObjectScanStatus {
  PENDING
  CLEAN
  INFECTED
  OUTAGE
  SKIPPED
}

enum StorageDataClass {
  SURVEY_ATTACHMENT
  EVIDENCE
  EXPORT
}

// ----------------------------------------
// MODELS
// ----------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String?    @map("password_hash")
  role         Role       @default(RESPONDENT)
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  authIdentities                AuthIdentity[]
  sessions                      Session[]
  demographicProfile            DemographicProfile?
  gamificationStat              GamificationStat?
  formsPublished                Form[]                     @relation("PublisherForms")
  responses                     Response[]
  notifications                 Notification[]
  topUpRequests                 TopUpRequest[]
  ledgerAccounts                LedgerAccount[]
  moderationDecisions           SurveyModerationDecision[] @relation("ModerationDecisionAdmin")
  surveyFeedback                SurveyFeedback[]
  /// Decision E5-D1: Admin recoveries of the completion-code limit.
  completionCodeLimitResets     CompletionCodeLimitReset[] @relation("CompletionCodeLimitResetRespondent")
  completionCodeLimitResetsByMe CompletionCodeLimitReset[] @relation("CompletionCodeLimitResetAdmin")

  surveyAttempts       SurveyAttempt[]
  integrityConsents    IntegrityConsent[]
  integrityAssessments IntegrityAssessment[]
  integrityIncidents   IntegrityIncident[]
  integrityReviews     IntegrityReview[]
  fraudLogs            FraudLog[]

  /// Interactive product tours (canvas section 20): progress per account.
  productTours ProductTourProgress[]

  /// FR-9 profile (Story IR.4b part A): display name, school, goal. Not matching fields.
  profile UserProfile?

  /// Plan 5.4: single-use password reset tokens (hash only).
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

enum OAuthFlowType {
  LOGIN
  LINK
}

model AuthIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerSubjectId String       @map("provider_subject_id")
  createdAt         DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubjectId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  sessionVersion Int                  @default(1) @map("session_version")
  csrfDigest     String               @map("csrf_digest")
  revoked        Boolean              @default(false)
  /// Plan 5.6: when and why `revoked` became true; NULL while active and on
  /// rows revoked before these columns existed.
  revokedAt      DateTime?            @map("revoked_at")
  revokedReason  SessionRevokeReason? @map("revoked_reason")
  expiresAt      DateTime             @map("expires_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshCredentials RefreshCredential[]

  @@index([userId])
  @@map("sessions")
}

model RefreshCredential {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  secretDigest String    @map("secret_digest")
  isUsed       Boolean   @default(false) @map("is_used")
  usedAt       DateTime? @map("used_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_credentials")
}

model OAuthIntent {
  id                    String        @id @default(uuid()) @db.Uuid
  flowType              OAuthFlowType @map("flow_type")
  targetUserId          String?       @map("target_user_id") @db.Uuid
  stateDigest           String        @map("state_digest")
  nonceDigest           String        @map("nonce_digest")
  browserBindingDigest  String        @map("browser_binding_digest")
  pkceVerifierEncrypted String        @map("pkce_verifier_encrypted")
  expiresAt             DateTime      @map("expires_at")
  consumedAt            DateTime?     @map("consumed_at")
  failedAt              DateTime?     @map("failed_at")
  createdAt             DateTime      @default(now()) @map("created_at")

  @@index([targetUserId])
  @@index([browserBindingDigest])
  @@index([expiresAt])
  @@map("oauth_intents")
}

model IdentityAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  action       String
  userId       String?  @map("user_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  outcome      String
  errorCode    String?  @map("error_code")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@map("identity_audit_logs")
}

model DemographicProfile {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @unique @map("user_id") @db.Uuid
  age               Int?
  location          String?
  householdIncome   String? @map("household_income")
  specificInterests Json?   @map("specific_interests")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("demographic_profiles")
}

model Form {
  id                       String         @id @default(uuid()) @db.Uuid
  publisherId              String         @map("publisher_id") @db.Uuid
  type                     FormType
  status                   FormStatus     @default(DRAFT)
  title                    String
  description              String?        @db.Text
  rewardPerResponse        Int            @map("reward_per_response")
  expectedCompletions      Int            @map("expected_completions")
  /// Times the survey entered CLOSED: the close identity of the Escrow keys
  /// close-refund:{formId}:c{closeCount} / reopen-escrow:{formId}:c{closeCount}.
  closeCount               Int            @default(0) @map("close_count")
  /// Who closed the survey most recently (decision E8-D1); NULL when never
  /// closed or closed before the column existed (not reopenable: fail closed).
  closeKind                FormCloseKind? @map("close_kind")
  /// Publisher's estimated completion time in whole minutes (decision E6-D2):
  /// picks the FR-14 reward pricing band enforced at publish. Optional on drafts.
  estimatedDurationMinutes Int?           @map("estimated_duration_minutes")
  /// Phase 5 C6: `Idempotency-Key` of the `POST /forms/external` request that
  /// created the survey (unique per Publisher) and the SHA-256 fingerprint of
  /// its body, so a retried request replays the survey instead of creating
  /// (and funding) a second one. NULL when created without a key.
  creationIdempotencyKey   String?        @map("creation_idempotency_key")
  creationRequestHash      String?        @map("creation_request_hash")
  /// Story IR.2b: when the survey closes automatically (close kind DEADLINE)
  /// and its leftover Escrow is refunded. NULL = no deadline.
  deadlineAt               DateTime?      @map("deadline_at")
  /// Plan 2.2: survey topic chosen in the wizard. Validated in the app layer
  /// against the shared topic list in @rescom/schemas; NULL = not set.
  topic                    String?        @map("topic")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  publisher User            @relation("PublisherForms", fields: [publisherId], references: [id])
  versions  FormVersion[]
  responses Response[]
  attempts  SurveyAttempt[]

  moderationDecisions SurveyModerationDecision[]
  surveyFeedback      SurveyFeedback[]

  @@unique([publisherId, creationIdempotencyKey])
  /// Story IR.2b: deadline-close sweep (PUBLISHED surveys past their deadline).
  @@index([status, deadlineAt])
  @@index([status, updatedAt])
  @@map("forms")
}

model FormVersion {
  id             String    @id @default(uuid()) @db.Uuid
  formId         String    @map("form_id") @db.Uuid
  versionNumber  Int       @map("version_number")
  schemaJson     Json      @map("schema_json") // Zod compatible form blocks
  targetingJson  Json?     @map("targeting_json")
  isPublished    Boolean   @default(false) @map("is_published")
  externalUrl    String?   @map("external_url")
  completionCode String?   @map("completion_code")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  form            Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  attempts        SurveyAttempt[]
  responses       Response[]
  integrityEvents IntegrityEvent[]

  moderationDecision        SurveyModerationDecision?
  surveyFeedback            SurveyFeedback[]
  completionCodeLimitResets CompletionCodeLimitReset[]

  @@unique([formId, versionNumber])
  @@map("form_versions")
}

model Response {
  id            String         @id @default(uuid()) @db.Uuid
  formId        String         @map("form_id") @db.Uuid
  formVersionId String         @map("form_version_id") @db.Uuid
  attemptId     String?        @unique @map("attempt_id") @db.Uuid
  respondentId  String?        @map("respondent_id") @db.Uuid // Nullable for Guest
  status        ResponseStatus @default(IN_PROGRESS)
  answersJson   Json?          @map("answers_json")
  ipAddress     String         @map("ip_address")
  isGuest       Boolean        @default(false) @map("is_guest")

  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  form        Form           @relation(fields: [formId], references: [id], onDelete: Restrict)
  formVersion FormVersion    @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  respondent  User?          @relation(fields: [respondentId], references: [id], onDelete: SetNull)
  attempt     SurveyAttempt? @relation(fields: [attemptId], references: [id])

  integrityAssessments IntegrityAssessment[]
  feedback             SurveyFeedback?

  /// Story IR.4a AC9: two partial indexes (Prisma 6 cannot express `WHERE`) are
  /// created by migration `20261001120200_publisher_results_indexes` only:
  ///   - `responses_version_completed_feed_idx`
  ///     (form_version_id, submitted_at DESC, id DESC) WHERE status IN ('SUBMITTED','VALIDATED')
  ///   - `responses_form_completed_submitted_idx`
  ///     (form_id, submitted_at) WHERE status IN ('SUBMITTED','VALIDATED')
  /// They are absent from `prisma db push` databases (not a promotion path) and
  /// are not in `prisma/sql/post-push-invariants.sql`.
  @@map("responses")
}

/// The unique index `ledger_accounts_user_id_account_class_currency_key` is
/// NULLS NOT DISTINCT in the database (migration
/// `20260924120000_harden_double_entry_ledger`) so system accounts
/// (user_id NULL) are unique too; `@@unique` cannot express that clause.
/// After `prisma db push`, apply `prisma/sql/post-push-invariants.sql`
/// (`npm run prisma:db-push` does both) to rebuild it with the clause.
model LedgerAccount {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String?            @map("user_id") @db.Uuid // Null for system accounts
  accountClass LedgerAccountClass @map("account_class")
  currency     String             @default("POINTS")
  balance      Int                @default(0) // Denormalized balance, derived from entries

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User?         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entries LedgerEntry[]

  @@unique([userId, accountClass, currency])
  @@map("ledger_accounts")
}

model LedgerJournal {
  id                String  @id @default(uuid()) @db.Uuid
  idempotencyKey    String  @unique @map("idempotency_key")
  description       String?
  reversesJournalId String? @unique @map("reverses_journal_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  entries         LedgerEntry[]
  // RESTRICT/RESTRICT matches migration 20260924120000_harden_double_entry_ledger:
  // a reversed journal is immutable financial authority and can never be removed.
  reversedJournal LedgerJournal? @relation("JournalReversal", fields: [reversesJournalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversal        LedgerJournal? @relation("JournalReversal")

  /// Plan 4.3 `GET /admin/ledger/journals`: keyset `before=<createdAt>:<id>`.
  @@index([createdAt, id])
  @@map("ledger_journals")
}

model LedgerEntry {
  id        String @id @default(uuid()) @db.Uuid
  journalId String @map("journal_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  amount    Int // Positive or negative. Sum of entries in a journal must be 0

  createdAt DateTime @default(now()) @map("created_at")

  journal LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  // Created by migration 20260917153000_double_entry_ledger; declared here so
  // `prisma migrate dev` does not generate a DROP INDEX for them.
  @@index([journalId])
  @@index([accountId])
  @@map("ledger_entries")
}

// ----------------------------------------
// V2 RESEARCH INTEGRITY ENGINE
// ----------------------------------------

/// Epic 5 review P1: two partial unique indexes (not expressible in Prisma 6)
/// are created by migration `20260926230000_participation_concurrency_guards`:
///   - `survey_attempts_one_active_per_account` (respondent_id, survey_id)
///     WHERE status = 'IN_PROGRESS' AND respondent_id IS NOT NULL
///   - `survey_attempts_one_completion_per_account` (respondent_id, survey_id)
///     WHERE status = 'COMPLETED' AND respondent_id IS NOT NULL
/// and re-asserted unconditionally by `20260927040000_reconcile_db_push_tables`.
/// Environments built with `prisma db push` must also apply
/// `prisma/sql/post-push-invariants.sql` (`npm run prisma:db-push` does both).
/// The `forms` row lock taken at attempt start stays the primary guarantee.
model SurveyAttempt {
  id                       String              @id @default(uuid()) @db.Uuid
  respondentId             String?             @map("respondent_id") @db.Uuid // Nullable for guest
  surveyId                 String              @map("survey_id") @db.Uuid
  formVersionId            String              @map("form_version_id") @db.Uuid
  status                   AttemptStatus       @default(IN_PROGRESS)
  isGuest                  Boolean             @default(false) @map("is_guest")
  startedAt                DateTime            @default(now()) @map("started_at")
  submittedAt              DateTime?           @map("submitted_at")
  /// Opaque, bounded client diagnostics; never read by server logic.
  clientContext            Json?               @map("client_context")
  /// Epic 5 review P2: server-owned completion-code security state (FR-22/23).
  failedCodeVerifications  Int                 @default(0) @map("failed_code_verifications")
  lastFailedVerificationAt DateTime?           @map("last_failed_verification_at")
  missingCodeReportedAt    DateTime?           @map("missing_code_reported_at")
  missingCodeReason        String?             @map("missing_code_reason")
  /// Story IR.2a: set with every ABANDONED transition (cancel, reservation
  /// expiry); NULL for open, completed and locked attempts and for rows
  /// abandoned before the column existed.
  closedReason             AttemptCloseReason? @map("closed_reason")
  closedAt                 DateTime?           @map("closed_at")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  respondent User?       @relation(fields: [respondentId], references: [id])
  form       Form        @relation(fields: [surveyId], references: [id])
  version    FormVersion @relation(fields: [formVersionId], references: [id])

  response             Response?
  integrityEvents      IntegrityEvent[]
  integrityAssessments IntegrityAssessment[]
  integrityIncidents   IntegrityIncident[]
  feedback             SurveyFeedback?

  /// Story 8.2: rolling-window completion rate limit (FR-46) per respondent.
  @@index([respondentId, status, submittedAt])
  /// Decision E5-D1: summed wrong codes per account and FormVersion.
  @@index([respondentId, formVersionId])
  /// Story IR.2b: reservation-expiry sweep (IN_PROGRESS attempts by age).
  @@index([status, startedAt])
  /// Story IR.4a AC9: publisher progress buckets and completed counts per survey.
  @@index([surveyId, status, submittedAt])
  /// Plan 4.1: partial index `survey_attempts_missing_code_reported_idx`
  /// (missing_code_reported_at) WHERE missing_code_reported_at IS NOT NULL, created by
  /// migration `20261001120800_missing_code_report_index` only (Prisma 6 cannot
  /// express `WHERE`); absent from `db push` databases.
  @@map("survey_attempts")
}

/// Code-review decision E5-D1 (2026-09-26): Admin recovery of the
/// account+FormVersion completion-code limit (`completion-code-policy-v1`,
/// provisional pending PRD Open Question 14). Append-only audit rows (who,
/// when, why, how many): the wrong codes a row forgives are subtracted from
/// the account's summed `survey_attempts.failed_code_verifications` on that
/// version. The attempts and their FraudLog evidence are never changed.
model CompletionCodeLimitReset {
  id               String   @id @default(uuid()) @db.Uuid
  respondentId     String   @map("respondent_id") @db.Uuid
  formVersionId    String   @map("form_version_id") @db.Uuid
  failuresForgiven Int      @map("failures_forgiven")
  /// The Admin who reset the limit.
  resetById        String   @map("reset_by_id") @db.Uuid
  reason           String
  policyVersion    String   @map("policy_version")
  createdAt        DateTime @default(now()) @map("created_at")

  respondent  User        @relation("CompletionCodeLimitResetRespondent", fields: [respondentId], references: [id], onDelete: Restrict)
  resetBy     User        @relation("CompletionCodeLimitResetAdmin", fields: [resetById], references: [id], onDelete: Restrict)
  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict)

  @@index([respondentId, formVersionId])
  @@map("completion_code_limit_resets")
}

model IntegrityConsent {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String
  noticeVersion Int       @map("notice_version")
  grantedAt     DateTime  @default(now()) @map("granted_at")
  revokedAt     DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  integrityEvents IntegrityEvent[]

  /// One acceptance per user, purpose and notice version: accepting the same
  /// notice again is idempotent (`INSERT … ON CONFLICT DO NOTHING`).
  @@unique([userId, purpose, noticeVersion])
  @@map("integrity_consents")
}

model IntegrityEvent {
  id                String             @id @default(uuid()) @db.Uuid
  clientEventId     String             @map("client_event_id")
  attemptId         String             @map("attempt_id") @db.Uuid
  respondentId      String?            @map("respondent_id") @db.Uuid
  formVersionId     String             @map("form_version_id") @db.Uuid
  questionId        String?            @map("question_id")
  consentId         String?            @map("consent_id") @db.Uuid
  eventType         IntegrityEventType @map("event_type")
  eventVersion      Int                @default(1) @map("event_version")
  sequence          Int?
  occurredAt        DateTime           @map("occurred_at") // Client time
  serverReceiptTime DateTime           @default(now()) @map("server_receipt_time") // Server time
  metadata          Json?
  createdAt         DateTime           @default(now()) @map("created_at")

  attempt SurveyAttempt     @relation(fields: [attemptId], references: [id])
  version FormVersion       @relation(fields: [formVersionId], references: [id])
  consent IntegrityConsent? @relation(fields: [consentId], references: [id])

  @@unique([attemptId, clientEventId])
  @@index([attemptId, eventType])
  @@map("integrity_events")
}

model IntegrityAssessment {
  id                   String                  @id @default(uuid()) @db.Uuid
  attemptId            String                  @map("attempt_id") @db.Uuid
  responseId           String                  @map("response_id") @db.Uuid
  respondentId         String?                 @map("respondent_id") @db.Uuid
  applicability        AssessmentApplicability @default(APPLICABLE)
  score                Decimal?
  confidence           Decimal?
  evidenceCoverage     Decimal?                @map("evidence_coverage")
  riskLevel            IntegrityRiskLevel?     @map("risk_level")
  componentScores      Json?                   @map("component_scores")
  reasonCodes          Json?                   @map("reason_codes")
  inputLineageChecksum String?                 @map("input_lineage_checksum")
  featureVersion       String                  @map("feature_version")
  scoringVersion       String                  @map("scoring_version")
  policyVersion        String?                 @map("policy_version")
  createdAt            DateTime                @default(now()) @map("created_at")

  attempt    SurveyAttempt @relation(fields: [attemptId], references: [id])
  response   Response      @relation(fields: [responseId], references: [id])
  respondent User?         @relation(fields: [respondentId], references: [id])

  @@index([respondentId, createdAt])
  @@index([responseId])
  @@map("integrity_assessments")
}

model RespondentReputation {
  id                    String   @id @default(uuid()) @db.Uuid
  respondentId          String   @unique @map("respondent_id") @db.Uuid
  integrityScoreRolling Decimal  @map("integrity_score_rolling")
  confidence            Decimal
  acceptedResponses     Int      @default(0) @map("accepted_responses")
  reviewedResponses     Int      @default(0) @map("reviewed_responses")
  confirmedIncidents    Int      @default(0) @map("confirmed_incidents")
  metrics               Json
  version               Int      @default(1)
  calculatedAt          DateTime @map("calculated_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("respondent_reputations")
}

model IntegrityIncident {
  id           String                  @id @default(uuid()) @db.Uuid
  attemptId    String?                 @map("attempt_id") @db.Uuid
  responseId   String?                 @map("response_id") @db.Uuid
  respondentId String                  @map("respondent_id") @db.Uuid
  type         IntegrityIncidentType
  status       IntegrityIncidentStatus @default(OPEN)
  severity     IntegritySeverity
  evidence     Json
  detectedAt   DateTime                @default(now()) @map("detected_at")
  reviewedAt   DateTime?               @map("reviewed_at")
  resolution   IntegrityResolution?
  createdAt    DateTime                @default(now()) @map("created_at")

  respondent User              @relation(fields: [respondentId], references: [id])
  attempt    SurveyAttempt?    @relation(fields: [attemptId], references: [id])
  reviews    IntegrityReview[]

  @@map("integrity_incidents")
}

model IntegrityReview {
  id         String              @id @default(uuid()) @db.Uuid
  incidentId String              @map("incident_id") @db.Uuid
  reviewerId String              @map("reviewer_id") @db.Uuid
  decision   IntegrityResolution
  reason     String?
  evidence   Json?
  createdAt  DateTime            @default(now()) @map("created_at")

  incident IntegrityIncident @relation(fields: [incidentId], references: [id])
  reviewer User              @relation(fields: [reviewerId], references: [id])

  @@map("integrity_reviews")
}

model FraudLog {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      FraudLogType
  details   Json?
  /// Story 8.2: evidence idempotency (one TIME_BARRIER row per attempt, one RATE_LIMIT row per window). Append-only.
  dedupeKey String?      @unique @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  /// Plan 4.2 `GET /admin/fraud-log`: keyset `(created_at, id)` and per-user filter.
  @@index([createdAt, id])
  @@index([userId, createdAt])
  @@map("fraud_logs")
}

model ScoringPolicy {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  version     Int
  status      PolicyStatus
  definition  Json
  activatedAt DateTime?    @map("activated_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@unique([name, version])
  @@map("scoring_policies")
}

model OutboxEvent {
  id               String  @id @default(uuid()) @db.Uuid
  idempotencyKey   String  @unique @map("idempotency_key")
  eventType        String  @map("event_type")
  schemaVersion    Int     @default(1) @map("schema_version")
  producer         String
  aggregateType    String  @map("aggregate_type")
  aggregateId      String  @map("aggregate_id")
  aggregateVersion Int     @default(1) @map("aggregate_version")
  orderingStream   String? @map("ordering_stream")
  streamSequence   Int?    @map("stream_sequence")
  correlationId    String? @map("correlation_id") @db.Uuid
  causationId      String? @map("causation_id") @db.Uuid
  payload          Json

  status            OutboxStatus @default(PENDING)
  attempts          Int          @default(0)
  availableAt       DateTime     @default(now()) @map("available_at")
  claimOwner        String?      @map("claim_owner")
  claimFencingToken String?      @map("claim_fencing_token")
  claimExpiresAt    DateTime?    @map("claim_expires_at")
  lastError         String?      @map("last_error")
  terminalState     String?      @map("terminal_state")

  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  /// Story IR.2b: stream-gap check and per-type backlog.
  @@index([orderingStream, streamSequence])
  @@index([eventType, status])
  @@map("outbox_events")
}

model ProcessedHandler {
  id             String   @id @default(uuid()) @db.Uuid
  handlerName    String   @map("handler_name")
  eventId        String?  @map("event_id") @db.Uuid
  streamSequence Int?     @map("stream_sequence") // Used for ordered streams
  processedAt    DateTime @default(now()) @map("processed_at")

  @@unique([handlerName, eventId])
  @@map("processed_handlers")
}

/// Story IR.2b (AD-10, AD-17): one row per scheduled job. A run claims the row
/// by setting `leaseOwner`/`leaseExpiresAt` and incrementing `fencingToken`;
/// a completion or renewal whose owner and token no longer match is rejected.
/// Platform Infrastructure owns it.
model SchedulerJobLease {
  jobName             String    @id @map("job_name")
  leaseOwner          String?   @map("lease_owner")
  fencingToken        BigInt    @default(0) @map("fencing_token")
  leaseExpiresAt      DateTime? @map("lease_expires_at")
  nextRunAt           DateTime  @default(now()) @map("next_run_at")
  lastStartedAt       DateTime? @map("last_started_at")
  lastFinishedAt      DateTime? @map("last_finished_at")
  /// SUCCEEDED | PARTIAL | FAILED | LEASE_LOST
  lastStatus          String?   @map("last_status")
  /// Counts only, never user ids or payloads.
  lastSummary         Json?     @map("last_summary")
  lastError           String?   @map("last_error")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("scheduler_job_leases")
}

model GamificationStat {
  userId                String    @id @map("user_id") @db.Uuid
  currentStreak         Int       @default(0) @map("current_streak")
  maxStreak             Int       @default(0) @map("max_streak")
  totalSurveysCompleted Int       @default(0) @map("total_surveys_completed")
  isTrustedResearcher   Boolean   @default(false) @map("is_trusted_researcher")
  lastSurveyDate        DateTime? @map("last_survey_date")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gamification_stats")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  /// Stable identity of the source event (e.g. the Ledger idempotency key);
  /// a replay of the same event cannot create a second notification (AD-10).
  dedupeKey String?          @map("dedupe_key")
  readAt    DateTime?        @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

/// Story IR.4b B5/B6 (Notifications-owned channel delivery attempt): at most
/// one provider send per notification. Keyed by the Outbox event idempotency
/// key (`notification-email:{notificationId}`). Stores no recipient address,
/// subject or body (AD-21); `lastErrorCode` is a code, never provider text.
/// `notificationId`/`userId` carry no foreign key on purpose: the delivery
/// record is an audit of a send and must never block a user deletion.
model EmailDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  idempotencyKey    String              @unique @map("idempotency_key")
  notificationId    String              @unique @map("notification_id") @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  notificationType  NotificationType    @map("notification_type")
  status            EmailDeliveryStatus
  attempts          Int                 @default(0)
  providerMessageId String?             @map("provider_message_id")
  lastErrorCode     String?             @map("last_error_code")
  sendingStartedAt  DateTime?           @map("sending_started_at")
  sentAt            DateTime?           @map("sent_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@map("email_deliveries")
}

/// Manual Point top-up request (Story 6.6, FR-34/FR-35). Economy owns it;
/// `PENDING` is the "Pending Payment" state. Approval commits the status
/// transition, the `topup-approval:{id}` Ledger journal and the admin-audit
/// Outbox event in one transaction (AD-16).
model TopUpRequest {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  /// Points to credit on approval.
  amount            Int
  /// VND the user must transfer (amount x 200).
  amountVnd         Int         @map("amount_vnd")
  /// Unique bank-transfer syntax shown to the user (e.g. RESCOMK7Q2M9XA).
  transferReference String      @unique @map("transfer_reference")
  status            TopUpStatus @default(PENDING)
  /// Reviewing Admin (actor) of the approval or rejection.
  adminId           String?     @map("admin_id") @db.Uuid
  /// Ledger journal posted by the approval.
  journalId         String?     @unique @map("journal_id") @db.Uuid
  rejectionReason   String?     @map("rejection_reason")
  /// Correlation id of the review command.
  correlationId     String?     @map("correlation_id") @db.Uuid
  reviewedAt        DateTime?   @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("top_up_requests")
}

/// Story 8.1 (FR-20, FR-53): one Admin moderation decision per submitted
/// FormVersion. Owned by the Moderation context; the Form transition itself is
/// owned by Research and the Escrow refund journal by Economy (AD-16).
model SurveyModerationDecision {
  id              String                  @id @default(uuid()) @db.Uuid
  formId          String                  @map("form_id") @db.Uuid
  /// The exact version the Admin previewed and decided on (AD-19).
  formVersionId   String                  @unique @map("form_version_id") @db.Uuid
  versionNumber   Int                     @map("version_number")
  outcome         SurveyModerationOutcome
  /// Deciding Admin (actor).
  adminId         String                  @map("admin_id") @db.Uuid
  /// Rejection reason (required) or optional approval note.
  reason          String?
  /// Escrow refunded to the Publisher on rejection.
  refundAmount    Int                     @default(0) @map("refund_amount")
  /// Economy journal of the refund (`close-refund:{formId}:c{closeCount}`,
  /// Epic 6 review P3).
  refundJournalId String?                 @map("refund_journal_id") @db.Uuid
  correlationId   String                  @map("correlation_id") @db.Uuid
  decidedAt       DateTime                @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// Append-only admin-action audit (Epic 8 review P13): deleting a decided
  /// form or version must fail instead of silently erasing its decision.
  form        Form        @relation(fields: [formId], references: [id], onDelete: Restrict)
  formVersion FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  admin       User        @relation("ModerationDecisionAdmin", fields: [adminId], references: [id])

  @@index([formId, decidedAt])
  @@index([adminId, decidedAt])
  @@map("survey_moderation_decisions")
}

/// Story 9.2 (FR-43): at most one post-completion feedback per completed
/// Attempt (unique `attemptId`). Owned by Participation. Rows start PENDING;
/// the Phase-2 Survey Quality validator consumes the `SurveyFeedbackSubmitted`
/// Outbox event and only ACCEPTED feedback is ever aggregated. Rating range and
/// comment length are also enforced by CHECK constraints in the migration.
model SurveyFeedback {
  id               String                         @id @default(uuid()) @db.Uuid
  attemptId        String                         @unique @map("attempt_id") @db.Uuid
  /// Internal Forms only (the validated Response of the attempt).
  responseId       String?                        @unique @map("response_id") @db.Uuid
  formId           String                         @map("form_id") @db.Uuid
  /// Exact pinned FormVersion of the attempt (Survey Quality is per version).
  formVersionId    String                         @map("form_version_id") @db.Uuid
  respondentId     String                         @map("respondent_id") @db.Uuid
  formType         FormType                       @map("form_type")
  /// Overall experience, 1..5 stars.
  rating           Int
  /// Normalized plain text (<= 500 chars); never rendered as HTML.
  comment          String?                        @db.Text
  issueTags        SurveyFeedbackIssueTag[]       @default([]) @map("issue_tags")
  validationStatus SurveyFeedbackValidationStatus @default(PENDING) @map("validation_status")
  validatedAt      DateTime?                      @map("validated_at")
  submittedAt      DateTime                       @map("submitted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attempt     SurveyAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  response    Response?     @relation(fields: [responseId], references: [id], onDelete: Cascade)
  form        Form          @relation(fields: [formId], references: [id], onDelete: Restrict)
  formVersion FormVersion   @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  respondent  User          @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@index([formId, validationStatus])
  @@index([formVersionId, validationStatus])
  @@index([respondentId, submittedAt])
  @@map("survey_feedback")
}

model StoredObject {
  id            String                 @id @default(uuid()) @db.Uuid
  ownerContext  String                 @map("owner_context")
  ownerRecordId String                 @map("owner_record_id") @db.Uuid
  questionId    String?                @map("question_id")
  dataClass     StorageDataClass       @default(SURVEY_ATTACHMENT) @map("data_class")
  storageKey    String                 @unique @map("storage_key")
  bucket        String
  fileName      String                 @map("file_name")
  fileSize      Int                    @map("file_size")
  mimeType      String                 @map("mime_type")
  checksum      String?
  status        StoredObjectStatus     @default(INITIATED)
  scanStatus    StoredObjectScanStatus @default(PENDING) @map("scan_status")
  scanPolicy    String?                @map("scan_policy")
  scanResult    Json?                  @map("scan_result")
  uploadedAt    DateTime?              @map("uploaded_at")
  scannedAt     DateTime?              @map("scanned_at")
  attachedAt    DateTime?              @map("attached_at")
  expiresAt     DateTime?              @map("expires_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([ownerContext, ownerRecordId])
  @@index([ownerContext, ownerRecordId, questionId])
  @@index([status, scanStatus])
  @@map("stored_objects")
}

/// Interactive product tours (canvas section 20). Values must stay identical to
/// `PRODUCT_TOUR_IDS` / `PRODUCT_TOUR_STATUSES` in @rescom/schemas.
enum ProductTourId {
  FIRST_SURVEY
  FIRST_PUBLISH
  TRACK_SURVEY
  FORM_BUILDER
}

enum ProductTourStatus {
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

/// One row per (user, tour) the user has started, finished or dismissed.
model ProductTourProgress {
  userId    String            @map("user_id") @db.Uuid
  tourId    ProductTourId     @map("tour_id")
  status    ProductTourStatus
  step      Int               @default(0)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tourId])
  @@map("product_tour_progress")
}

/// FR-9 goal (Story IR.4b part A). Values must stay identical to `USER_GOALS`
/// in @rescom/schemas. Intent only: never a role, status or permission.
enum UserGoal {
  EARN
  COLLECT
  BOTH
}

/// FR-9 amendment 2026-09-26: `school` = university, `schoolYear` = academic
/// year; not matching fields. `birthYear` is for display and prefill only: the
/// demographic `age` stays the matching field. Created by the first
/// `PATCH /users/me/profile`; a user without a row reads as all-null.
model UserProfile {
  userId      String    @id @map("user_id") @db.Uuid
  displayName String?   @map("display_name") @db.VarChar(50)
  birthYear   Int?      @map("birth_year")
  school      String?   @db.VarChar(200)
  schoolYear  String?   @map("school_year") @db.VarChar(20)
  goal        UserGoal?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// Plan 5.4: single-use password reset token. Only the SHA-256 hex digest of
/// the random token is stored (`tokenHash`); the raw token exists only in the
/// email link. A token is valid while `usedAt` IS NULL and `expiresAt > now`.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}
