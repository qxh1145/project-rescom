# "enabled" = MSW intercepts API calls in the browser; "disabled" = requests go to the real backend
NEXT_PUBLIC_API_MOCKING=enabled
# Base path for API calls. Keep "/api" so the Next rewrite proxies to the backend (same-origin cookies + CSRF).
NEXT_PUBLIC_API_URL=/api
# Target of the Next /api rewrite (server-side only)
RESCOM_API_URL=http://localhost:4000
