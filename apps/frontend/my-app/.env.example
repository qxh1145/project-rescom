# API mocking mode (mock-off plan, gate G):
#   "enabled"  = MSW answers every API call (tests, demo; demo accounts + mock Google sign-in)
#   "hybrid"   = real backend for everything except the deferred PRD routes (DEFERRED_KEEP_MOCK in
#                mocks/route-allowlist.ts: disputes, quality, reliability, AI, engagement), shown as "Dữ liệu minh hoạ"
#   "disabled" = real backend only, no MSW
NEXT_PUBLIC_API_MOCKING=hybrid
# Base path for API calls. Keep "/api" so the Next rewrite proxies to the backend (same-origin cookies + CSRF).
NEXT_PUBLIC_API_URL=/api
# Target of the Next /api rewrite (server-side only)
RESCOM_API_URL=http://localhost:4000
# Server-side only, never NEXT_PUBLIC_ (Story 11.1). On Vercel: equal to EDGE_KEY in the VM's deploy/.env.prod;
# proxy.ts sends it with the client IP so Caddy accepts the /api call. Leave unset locally.
# RESCOM_EDGE_KEY=
# Pilot build (IR.1): "true" hides the deferred screens (reliability, complaints, quality, export, version diff,
# streak/tier/leaderboard, AI builder, guest form /f/[id]). Unset (default) keeps every screen, for dev.
# Build-time: set it together with NEXT_PUBLIC_API_MOCKING=disabled.
# NEXT_PUBLIC_PILOT_BUILD=true
